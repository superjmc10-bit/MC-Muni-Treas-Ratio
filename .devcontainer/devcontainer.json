{
  "name": "Muni Ratio Monte Carlo",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2 },
  "waitFor": "onCreateCommand",
  "updateContentCommand": "pip3 install --user -r requirements.txt",
  "postAttachCommand": {
    "app": "streamlit run app.py --server.headless true --server.enableCORS false --server.enableXsrfProtection false"
  },
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": { "label": "Muni MC app", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "config/default.yaml"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
